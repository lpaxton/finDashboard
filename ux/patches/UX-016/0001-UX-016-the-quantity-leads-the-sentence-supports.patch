@@ -45,6 +45,32 @@ export const SLIPPING = {
 const item = (role, weight, meaning, action, source, extra = {}) =>
   ({ role, weight, meaning, action, source, ...extra });
 
+/* UX-016: the figure that leads the item. `kind` is one of time · money · limit · process ·
+   trend (format.js leadGlyph). The figure is short enough to sit in a 44px square: days as
+   "92d", money as "$12k", a limit as "24%", steps as "2/6", a draft as the word.
+   Where an item comes from a NextAction or an Alert the number is read back out of the sentence
+   the server composed, because the contract carries no structured figure. That is the honest
+   limit of this patch: the right fix is a `lead` on NextAction and Alert, decided server-side,
+   so the glyph can never disagree with the sentence. Logged for the contract. */
+const lead = (kind, figure, unit, title) => ({ kind, figure: String(figure), unit, title });
+const shortMoney = (n) => n >= 1e6 ? '$' + (n / 1e6).toFixed(1).replace(/\.0$/, '') + 'M'
+  : n >= 1e3 ? '$' + Math.round(n / 1e3) + 'k' : '$' + Math.round(n);
+function leadFromText(text, fallbackKind) {
+  const days = /(\d+)\s*days?/i.exec(text);
+  const money = /\$([\d,]+)/.exec(text);
+  const pctm = /(\d+(?:\.\d+)?)%/.exec(text);
+  const steps = /(\d+)\s*of\s*(\d+)\s*steps?/i.exec(text);
+  if (steps) return lead('process', steps[1] + '/' + steps[2], '', t('steps outstanding'));
+  if (money) return lead('money', shortMoney(Number(money[1].replace(/,/g, ''))), '', t('at stake'));
+  if (pctm) return lead('limit', pctm[1] + '%', '', t('over the limit'));
+  if (days) return lead('time', days[1], 'd', t('days'));
+  if (/\bform\b/i.test(text)) return lead('process', t('form'), '', t('a form is incomplete'));
+  if (/document/i.test(text)) return lead('process', t('docs'), '', t('documents needed'));
+  if (/margin/i.test(text)) return lead('limit', t('due'), '', t('past due'));
+  if (/restrict/i.test(text)) return lead('limit', t('held'), '', t('account restricted'));
+  return lead(fallbackKind, fallbackKind === 'process' ? t('stalled') : '!', '', '');
+}

   return t('another connected system');
 };
 
+/* ---- UX-016: the quantity leads, the sentence supports ------------------------------------
+   Every item on a role card is a number about a person — days quiet, dollars at stake, a limit
+   breached, steps outstanding. The glyph pulls that number out as the lead so the item can be
+   scanned before it is read, and its colour says what KIND of number it is (ST-04: every element
+   carries meaning, the same everywhere). Four kinds, plus a trend for the scorecard:
+     time     something has gone quiet, and days are the cost
+     money    an amount at stake
+     limit    a threshold breached
+     process  a thing stalled part-way (a draft, a form, steps)
+     trend    moved for or against, from the scorecard
+   The kinds reuse the status tints on purpose (tint + word, never a solid fill): a separate
+   signal-kind palette is a design-system call, not something to invent in a patch. */
+export function leadGlyph(lead) {
+  if (!lead) return '';
+  const unit = lead.unit ? `<small>${esc(lead.unit)}</small>` : '';
+  const title = lead.title ? ` title="${esc(lead.title)}"` : '';
+  return `<span class="qty qty-${esc(lead.kind)}" aria-hidden="true"${title}>${esc(lead.figure)}${unit}</span>`;
+}
+
+/* A kind-of-source mark in front of the source line (TR-10): the kind is already in the words,
+   so the mark only makes it scannable. Stroke icons inherit the line's colour. */
+const MARK = {
+  greenmeadows: '<path d="M3 10h18M5 10v9M19 10v9M9 10v9M15 10v9M3 19h18M12 3l9 6H3z"/>',
+  crm: '<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/>',
+  calendar: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>',
+  notes: '<path d="M6 3h9l5 5v13H6z M14 3v6h6M9 13h6M9 17h6"/>',
+  market: '<path d="M3 17l5-6 4 3 5-7 4 4"/>',
+  platform: '<circle cx="12" cy="12" r="9"/><path d="M8 12l3 3 5-6"/>'
+};
+export function sourceMarks(sources) {
+  const kinds = [...new Set([].concat(sources ?? []).filter(Boolean))].filter(k => MARK[k]);
+  if (!kinds.length) return '';
+  return `<span class="srcmarks" aria-hidden="true">${kinds.map(k =>
+    `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">${MARK[k]}</svg>`).join('')}</span>`;
+}
+
 /* "From custodian records, your CRM and your calendar \u00b7 updated 2 hrs ago".
    Takes one source or a list; the age is optional, because not every source carries one. */
 export function sourceLine(sources, at) {

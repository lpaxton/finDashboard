@@ -633,6 +633,35 @@ dialog.sheet { max-width: 460px; border: 1px solid var(--line); border-radius: v
   font: 500 10px/1 var(--mono); text-transform: uppercase; letter-spacing: 0.08em; padding: 4px 8px; margin-bottom: 8px; }
 .well-actions { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }
 
+/* ---- UX-016: the quantity leads, the sentence supports --------------------------------------
+   A 44px glyph carries the item's figure in the serif, coloured by the KIND of signal; the
+   sentence sits beside it as support. Tint + figure, never a solid fill, so it reads as meaning
+   rather than as a button. In a row the glyph is the first column; in the well it sits beside
+   the whole item, label and all. */
+/* Class is .qty, not .lead: .lead is already the leading role section on Today. */
+.qty { flex: 0 0 auto; width: 44px; height: 44px; border-radius: 10px; display: inline-flex; align-items: center; justify-content: center;
+  font: 600 16px/1 var(--serif); letter-spacing: -0.01em; font-variant-numeric: tabular-nums; white-space: nowrap; }
+.qty small { font: 500 10px/1 var(--mono); margin-left: 1px; align-self: flex-end; padding-bottom: 1px; }
+.qty-time    { background: var(--warn-soft); color: var(--warn); }
+.qty-money   { background: var(--ok-soft);   color: var(--ok); }
+.qty-limit   { background: var(--crit-soft); color: var(--crit); }
+.qty-process { background: var(--mist);      color: var(--ink); font-family: var(--mono); font-size: 11px; font-weight: 500; letter-spacing: 0.02em; }
+.qty-trend-up   { background: var(--ok-soft);   color: var(--ok); }
+.qty-trend-down { background: var(--warn-soft); color: var(--warn); }
+/* Rows that carry a glyph: glyph · text · action, the text column never pushing the page wider. */
+.rows.items > li { flex-wrap: nowrap; align-items: center; }
+.rows.items > li > .grow { min-width: 0; }
+.rows.items .title { line-height: 1.35; }
+/* The well: the label stays on top; under it the glyph sits beside the item. Flex rather than
+   grid, because Today's cards sit in CSS columns and Chromium will split a grid across a column
+   break even with break-inside: avoid on the card. */
+.well-row { display: flex; gap: 14px; align-items: flex-start; }
+.well-row > .qty { margin-top: 2px; }
+.well-row > .well-main { flex: 1 1 auto; min-width: 0; }
+/* Kind-of-source marks in front of the source line (TR-10), the line's own colour. */
+.srcmarks { display: inline-flex; gap: 3px; vertical-align: -2px; margin-right: 6px; }
+.srcmarks svg { width: 12px; height: 12px; }
+
 /* ---- SimGPT: rehearsing a conversation (AX-05, AX-06, AX-07) ------------------------------ *
    A wider panel than Ask, because this is a conversation with turns rather than a question with
    an answer, and a 420px column turns every reply into a narrow stack. */
